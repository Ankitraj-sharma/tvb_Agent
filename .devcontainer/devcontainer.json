{
  "name": "The Venture Build (TVB) OS",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "TVB Application",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "npm run dev"
}
